# Пример доступов для tools/deploy.sh.
# Скопируйте в tools/.deploy.env и заполните (в git не попадёт — см. .gitignore).
# Формат URL: ftp://пользователь@сервер/путь или sftp://пользователь@сервер/путь
DEPLOY_URL="ftp://user@ftp.host.ru/public_html"
DEPLOY_PASS="пароль"
# Адрес сайта — для автоматической проверки после заливки
# (главная и статика — 200, api.php — JSON, ?v= на сервере свежая).
SITE_URL="https://crmdetroid.ru"
